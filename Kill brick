-- 1. Reference the brick this script is attached to
local brick = script.Parent

-- 2. Create the function that will execute when someone touches the brick
local function onTouch(otherPart)
	-- Look inside the object that touched the brick to see if it belongs to a Player (Character)
	local character = otherPart.Parent
	local humanoid = character:FindFirstChildOfClass("Humanoid")

	-- 3. If a Humanoid (player) exists, set their health to 0
	if humanoid then
		humanoid.Health = 0
	end
end

-- 4. Listen for the "Touched" event and trigger our function
brick.Touched:Connect(onTouch)
